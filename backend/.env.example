# Server
NODE_ENV=development
PORT=4000
# Production: set both to your HTTPS domain, e.g. https://instahelp.in
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# Database
# Password with special chars must be URL-encoded ($ → %24)
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Render/serverless: use Supabase pooler (Connect → Prisma in dashboard)
# DATABASE_URL = transaction pooler :6543 ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = session pooler :5432
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Encryption key for payment credentials (32-byte hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin bootstrap (first admin phone for OTP login)
ADMIN_PHONE=+919999999999

# OTP (dev mode logs OTP to console; set SMS provider in production)
OTP_EXPIRY_MINUTES=10
OTP_DEV_MODE=true

# PhonePe defaults (overridden by admin payment settings in DB)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=production
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
