generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OwnerType {
  ADMIN
  VENDOR
}

enum PaymentProvider {
  PHONEPE
  RAZORPAY
}

enum UserRole {
  USER
  VENDOR
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  email     String?  @unique
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  auditLogs  AuditLog[]
  otpSessions OtpSession[]

  @@index([phone])
  @@map("users")
}

model Vendor {
  id        String       @id @default(uuid())
  shopName  String
  ownerName String
  phone     String       @unique
  email     String?
  status    VendorStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders Order[]

  @@index([status])
  @@map("vendors")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String?
  vendorId      String?
  serviceName   String        @default("Service Request")
  vendorName    String?
  quantity      Int           @default(1)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  convenienceFee Decimal      @default(0) @db.Decimal(12, 2)
  gst           Decimal       @default(0) @db.Decimal(12, 2)
  amount        Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING)
  idempotencyKey String?      @unique
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([vendorId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([createdAt])
  @@map("orders")
}

model Transaction {
  id              String            @id @default(uuid())
  orderId         String
  transactionId   String            @unique
  providerTxnId   String?
  provider        PaymentProvider   @default(PHONEPE)
  amount          Decimal           @db.Decimal(12, 2)
  status          TransactionStatus @default(PENDING)
  paymentMode     String?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([providerTxnId])
  @@map("transactions")
}

model PaymentAccount {
  id            String          @id @default(uuid())
  ownerType     OwnerType
  ownerId       String
  provider      PaymentProvider @default(PHONEPE)
  merchantId    String?
  clientId      String?
  saltKey       String?
  saltIndex     String?
  environment   String          @default("sandbox")
  webhookUser   String?
  webhookPass   String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([ownerType, ownerId, provider])
  @@index([ownerType, ownerId])
  @@map("payment_accounts")
}

model AppSettings {
  id              String   @id @default("default")
  businessName    String   @default("InstaHelp")
  supportEmail    String?
  supportNumber   String?
  paymentsEnabled Boolean  @default(true)
  phonepeEnabled  Boolean  @default(true)
  razorpayEnabled Boolean  @default(true)
  successUrl      String   @default("/payment-success.html")
  failureUrl      String   @default("/payment-failed.html")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("app_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OtpSession {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String
  userId    String?
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_sessions")
}

model ProcessedWebhook {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("processed_webhooks")
}
